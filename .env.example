# Copy this file to .env.local and fill in only the values you need locally.
# Never commit real credentials.

# Email reporting (browser-visible; use a limited demo webhook, never a secret)
VITE_MAKE_WEBHOOK_URL=

# Server-side AI (read only by /api functions; never prefix these with VITE_)
# Supported provider: gemini. All three values are required for live AI.
# Example placeholders: AI_PROVIDER=gemini, AI_MODEL=<gemini-model-id>
# Set real values in Vercel Project Settings → Environment Variables.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
